# Forge AI environment variables
# Copy this file to .env and fill in your values.

# --- Required ---
# Provided automatically by Replit when you add a Postgres database:
DATABASE_URL=postgres://user:pass@host:5432/db

# OpenRouter API key (primary provider):
OPENROUTER_API_KEY=sk-or-...
# Groq API key (fast fallback):
GROQ_API_KEY=gsk_...
# Kilo API key (free tier fallback):
KILO_API_KEY=...
# Custom OpenAI-compatible endpoint (optional):
AI_ENDPOINT=https://your-endpoint.com/v1/chat/completions
AI_API_KEY=...

# --- Stock images (optional but recommended) ---
# Unsplash access key (required for stock imagery in generated sites):
UNSPLASH_ACCESS_KEY=...
# Pexels API key (fallback when Unsplash has no match):
PEXELS_API_KEY=...

# --- Payments (optional; payments disabled without these) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Optional overrides (defaults shown) ---
PORT=4000
BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:8080
MODEL_STANDARD=google/gemini-2.5-flash
MODEL_ANALYSIS=google/gemini-2.5-flash
MODEL_SPEC=google/gemini-2.5-flash
MODEL_COPY=google/gemini-2.5-flash
MODEL_CRITIC=
ANALYSIS_DAILY_LIMIT=5
STORAGE_BUCKET=projects
JOB_CONCURRENCY=2
ALLOW_FREE_GENERATION=false
NODE_ENV=production
